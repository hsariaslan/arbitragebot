DASHBOARD_USERNAME=admin
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
# Legacy (deprecated, auto-hashed at runtime): DASHBOARD_PASSWORD=yourpassword
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
TRUSTED_PROXIES=127.0.0.1,::1
ALLOWED_ORIGINS=https://your-domain.com
DASHBOARD_BIND_HOST=127.0.0.1
