DASHBOARD_USERNAME=admin
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
# Legacy (deprecated, auto-hashed at runtime): DASHBOARD_PASSWORD=yourpassword
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
TRUSTED_PROXIES=127.0.0.1,::1
ALLOWED_ORIGINS=https://your-domain.com
DASHBOARD_BIND_HOST=127.0.0.1

# Demo/Testnet API Keys (for portfolio comparison)
# Binance Testnet: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# OKX Demo: Create Demo Trading API key at okx.com > Trade > Demo Trading
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=
# Bybit Demo: Create API key in Demo Trading mode at bybit.com
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
