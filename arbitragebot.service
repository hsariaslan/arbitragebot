[Unit]
Description=ArbitrageBot Crypto Arbitrage Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/arbitragebot
ExecStart=/root/arbitragebot/.venv/bin/python run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
